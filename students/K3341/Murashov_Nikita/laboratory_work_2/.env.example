# cp .env.example .env и подставьте свои значения. Файл .env в git не попадает.
# Ключ: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

DB_NAME=conferences
DB_USER=conferences
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Необязательно: пароли для `python manage.py seed`. Если пусто, пароли генерируются и печатаются.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
