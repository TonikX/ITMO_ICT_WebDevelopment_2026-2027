# cp .env.example .env. Файл .env в git не попадает.
# Ключ: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# Необязательно: пароли для `python manage.py seed`. Если пусто, пароли генерируются и печатаются.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
