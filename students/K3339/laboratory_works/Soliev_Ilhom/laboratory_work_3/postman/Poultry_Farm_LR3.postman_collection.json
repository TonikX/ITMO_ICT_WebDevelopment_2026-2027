  "item": [
    {
      "name": "Авторизация",
      "item": [
        {
          "name": "Регистрация",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/auth/users/",
            "description": "Зарегистрировать worker-аккаунт.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"worker_example\",\n  \"email\": \"worker@example.com\",\n  \"password\": \"ChangeThisPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Получить токен",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/auth/token/login/",
            "description": "Войти. Токен из ответа auth_token автоматически сохраняется в переменную коллекции token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"worker_example\",\n  \"password\": \"ChangeThisPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.auth_token) pm.collectionVariables.set('token', data.auth_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Текущий пользователь",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/users/me/",
            "description": "Получить данные текущего пользователя и его роль."
          }
        },
        {
          "name": "Выйти",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/token/logout/",
            "description": "Удалить текущий токен."
          }
        }
      ]
    },
